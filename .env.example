NODE_ENV=development
PORT=5000
PRODUCTION_READINESS_LOCK=true
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
PUBLIC_SITE_URL=http://localhost:5173

MONGO_URI=mongodb://127.0.0.1:27017/crossed-hearts
JWT_SECRET=replace-with-a-long-random-secret
REGISTRATION_ENCRYPTION_SECRET=replace-with-a-long-random-registration-secret
READ_TOKEN_EXPIRES_IN=2m
REQUIRE_READ_TOKEN=true
ADMIN_2FA_REQUIRED=false
ADMIN_IP_ALLOWLIST=
LICENSER_JWT_SECRET=replace-with-a-long-random-licenser-secret

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-smtp-user
EMAIL_PASS=your-smtp-password
EMAIL_FROM="Crossed Hearts <no-reply@example.com>"
BREVO_API_KEY=your-brevo-transactional-email-api-key
EMAIL_CONNECTION_TIMEOUT_MS=10000
EMAIL_GREETING_TIMEOUT_MS=10000
EMAIL_SOCKET_TIMEOUT_MS=20000
EMAIL_FORCE_IPV4=true
TEST_EMAIL_SECRET=replace-with-temporary-test-email-secret

PDF_STORAGE_PATH=./uploads/pdfs
PDF_STORAGE_DRIVER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
ATLAS_BACKUP_ENABLED=false
MONGODB_BACKUP_ENABLED=false
NOTIFY_UPLOAD_SECRET=replace-with-a-random-notification-secret

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_ALLOWED_CURRENCIES=usd
ALLOW_MANUAL_PURCHASE=false
ALLOW_MANUAL_PHYSICAL_ORDERS=false
ALLOW_MANUAL_CAMPAIGN_PLEDGES=false
PHYSICAL_SHIPPING_FEE=4.99
CAMPAIGN_GOAL_AMOUNT=10000
